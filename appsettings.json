{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore.Server.Kestrel": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Firmware": {
    "Directory": "",
    "Update": "All",
    "Version": "",
    "MaxDownloads": 3,
    "ScanIntervalSeconds": 60
  },
  "HaMqtt": {
    "Broker": "",
    "Port": 1883,
    "Username": "",
    "Password": ""
  },
  "Display": {
    "Layout": "Dashboard"
  },
  "HomeAssistant": {
    "Url": "",
    "Token": "",
    "MaxAgeMinutes": 30
  },
  "Dashboard": {
    "Grayscale": false,
    "PowerQueue": "",
    "Temperature": [],
    "Humidity": [],
    "AirQuality": [],
    "Voltage": [],
    "DroneAlert": "",
    "MissileAlert": "",
    "UpsStatus": "",
    "NextPowerOff": "",
    "NextPowerOn": "",
    "ForecastStation": "",
    "ForecastCity": "",
    "ForecastRegion": "",
    "RoomTemperature": [],
    "RoomHumidity": [],
    "GridOnVoltage": 100,
    "BatteryEmptyVoltage": 3.3,
    "BatteryFullVoltage": 4.1,
    "BatteryLowPercent": 20,
    "TimeoutSeconds": 8
  }
}
